# --- DATABASE (Drizzle & Supabase Direct) ---
# Used by Drizzle Kit to push schemas and Drizzle ORM to query data.
# Replace [PASSWORD] and [PROJECT-ID] with your actual Supabase details.
DATABASE_URL="postgres://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres"

# --- SUPABASE AUTH & CLIENT ---
# Used by @supabase/ssr to handle user login and client-side fetching.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# --- CLOUDINARY (Images & Media) ---
# Used by next-cloudinary to display and transform images.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="duz0sn8az"
# Optional: Only needed if you are doing server-side uploads/deletes
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"